# Which extractor runs: "deepseek" (local GPU), "ensemble" (deepseek + claude witness), "claude" (needs ANTHROPIC_API_KEY) or "stub" (demo data)
EXTRACTOR=deepseek
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-OCR-2
# DEEPSEEK_REVISION=<commit sha>   # pin it: the model repo ships code that we execute
DEEPSEEK_4BIT=1                    # 0 = bf16, needs ~8 GB VRAM
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional accuracy aids (off by default; keep only if they lower the silent-error rate, claude.md section 11)
# TABLE_CROP=1    # Table Transformer crops as OCR evidence for scans (pip install timm)
# LABEL_MAP=1     # Claude re-tags unknown row labels; sees labels only, never values

# 1 = one read, 2 = two independent reads, disputes settled by evidence
PASSES=2

DATA_DIR=data
MAX_UPLOAD_MB=50
MAX_FILES=20
MAX_PAGES=40
MODEL_DPI=300
VIEW_DPI=110
